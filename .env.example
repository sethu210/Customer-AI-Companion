# Copy to .env and fill in. .env is never committed.

# LLM provider (config/llm_config.hocon uses an OpenRouter model)
OPENROUTER_API_KEY=

# Customer data backend for the customer_service agents: mock | databricks
CUSTOMER_DATA_BACKEND=mock

# Databricks (only when CUSTOMER_DATA_BACKEND=databricks). Auth is the Databricks CLI login (databricks auth login).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
# Full path to databricks.exe if it is not on PATH
DATABRICKS_CLI_PATH=
# Seconds to wait for the MCP path before the SQL fallback; 0 = SQL only
DATABRICKS_MCP_TIMEOUT_S=0

# Phoenix tracing (installed in the "observability" uv group). Start Phoenix with: .\scripts\phoenix.ps1 start
PHOENIX_ENABLED=false
PHOENIX_AUTOSTART=false
PHOENIX_PROJECT_NAME=everly
OTEL_SERVICE_NAME=everly
